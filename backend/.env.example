# Environment: development | production
ENV=development

# Public URL of the app (used for the GitHub OAuth callback)
BASE_URL=http://localhost:8000

# Database. Local dev uses SQLite; production uses Postgres, e.g.
# postgresql+psycopg://user:password@db:5432/workouts
DATABASE_URL=sqlite:///./dev.db

# Session signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Signup gate. Comma-separated "provider:identifier" pairs.
# Empty = open signups. e.g. github:leopeltola,github:someoneelse
ALLOWED_IDENTITIES=github:leopeltola

# GitHub OAuth application
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the built frontend lives (as mounted in the Docker image)
STATIC_DIR=frontend_dist
